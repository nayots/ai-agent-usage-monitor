<Window x:Class="AiUsageMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AiUsageMonitor.App.Controls"
        xmlns:domain="clr-namespace:AiUsageMonitor.Domain;assembly=AiUsageMonitor.Domain"
        Title="AI Usage Monitor token gallery" Width="360" Height="520"
        Background="{DynamicResource WidgetWindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border Margin="1" Padding="10" CornerRadius="{DynamicResource RadiusWindow}" BorderBrush="{DynamicResource WidgetWindowStrokeBrush}" BorderThickness="1">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Token gallery — not the widget" Style="{StaticResource SubtitleTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}" />
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
          <RadioButton x:Name="SystemThemeRadioButton" Content="System" Checked="ThemeRadioButton_Checked" />
          <RadioButton x:Name="LightThemeRadioButton" Content="Light" Margin="8,0,0,0" Tag="Light" Checked="ThemeRadioButton_Checked" />
          <RadioButton x:Name="DarkThemeRadioButton" Content="Dark" Margin="8,0,0,0" Tag="Dark" Checked="ThemeRadioButton_Checked" />
        </StackPanel>
        <CheckBox x:Name="ColorBarsCheckBox" Margin="0,6,0,0" Content="Color bars by usage" />
        <TextBlock Margin="0,10,0,2" Text="Usage bands" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <controls:QuotaBar UsedPercent="0" ColorBarsByUsage="{Binding IsChecked, ElementName=ColorBarsCheckBox}" />
        <controls:QuotaBar UsedPercent="25" ColorBarsByUsage="{Binding IsChecked, ElementName=ColorBarsCheckBox}" />
        <controls:QuotaBar UsedPercent="74" ColorBarsByUsage="{Binding IsChecked, ElementName=ColorBarsCheckBox}" />
        <controls:QuotaBar UsedPercent="75" ColorBarsByUsage="{Binding IsChecked, ElementName=ColorBarsCheckBox}" />
        <controls:QuotaBar UsedPercent="99" ColorBarsByUsage="{Binding IsChecked, ElementName=ColorBarsCheckBox}" />
        <controls:QuotaBar UsedPercent="100" ColorBarsByUsage="{Binding IsChecked, ElementName=ColorBarsCheckBox}" />
        <TextBlock Margin="0,6,0,2" Text="Usage bands with color bars by usage off" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <controls:QuotaBar UsedPercent="0" ColorBarsByUsage="False" />
        <controls:QuotaBar UsedPercent="25" ColorBarsByUsage="False" />
        <controls:QuotaBar UsedPercent="74" ColorBarsByUsage="False" />
        <controls:QuotaBar UsedPercent="75" ColorBarsByUsage="False" />
        <controls:QuotaBar UsedPercent="99" ColorBarsByUsage="False" />
        <controls:QuotaBar UsedPercent="100" ColorBarsByUsage="False" />
        <TextBlock Margin="0,10,0,2" Text="Marker and state cases" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <controls:QuotaBar />
        <controls:QuotaBar UsedPercent="25" />
        <controls:QuotaBar UsedPercent="25" ElapsedFraction="0" />
        <controls:QuotaBar UsedPercent="25" ElapsedFraction="1" />
        <controls:QuotaBar UsedPercent="100" ElapsedFraction="0.25" />
        <controls:QuotaBar UsedPercent="40" LimitReached="True" />
        <TextBlock Margin="0,6,0,2" Text="Stale usage bands" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <controls:QuotaBar UsedPercent="0" IsStale="True" />
        <controls:QuotaBar UsedPercent="25" IsStale="True" />
        <controls:QuotaBar UsedPercent="74" IsStale="True" />
        <controls:QuotaBar UsedPercent="75" IsStale="True" />
        <controls:QuotaBar UsedPercent="99" IsStale="True" />
        <controls:QuotaBar UsedPercent="100" IsStale="True" />
        <TextBlock Margin="0,10,0,2" Text="Connection states" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <WrapPanel>
          <controls:StateChip State="{x:Static domain:ConnectionState.Connected}" Label="Connected" Margin="0,0,8,4" />
          <controls:StateChip State="{x:Static domain:ConnectionState.Discovering}" Label="Discovering" Margin="0,0,8,4" />
          <controls:StateChip State="{x:Static domain:ConnectionState.Waiting}" Label="Waiting" Margin="0,0,8,4" />
          <controls:StateChip State="{x:Static domain:ConnectionState.Stale}" Label="Stale" Margin="0,0,8,4" />
          <controls:StateChip State="{x:Static domain:ConnectionState.Unavailable}" Label="Unavailable" Margin="0,0,8,4" />
          <controls:StateChip State="{x:Static domain:ConnectionState.Error}" Label="Error" Margin="0,0,8,4" />
          <controls:StateChip State="{x:Static domain:ConnectionState.Unsupported}" Label="Unsupported" Margin="0,0,8,4" />
          <controls:StateChip State="{x:Static domain:ConnectionState.NotInstalled}" Label="Not installed" Margin="0,0,8,4" />
        </WrapPanel>
        <TextBlock Margin="0,6,0,2" Text="Mechanism tier" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
        <StackPanel Orientation="Horizontal">
          <controls:TierBadge Tier="{x:Static domain:MechanismTier.Official}" />
          <controls:TierBadge Tier="{x:Static domain:MechanismTier.Unofficial}" Margin="6,0,0,0" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
