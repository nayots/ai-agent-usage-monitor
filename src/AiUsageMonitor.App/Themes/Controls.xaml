<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AiUsageMonitor.App.Controls"
                    xmlns:domain="clr-namespace:AiUsageMonitor.Domain;assembly=AiUsageMonitor.Domain">
  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

  <Style x:Key="LinkButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource WidgetFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
    </Style.Triggers>
  </Style>

  <!-- The title bar's icon buttons. Same 30x26 hit area as the minimise and close glyphs beside
       them, so the row reads as one set rather than as two kinds of control. -->
  <Style x:Key="TitleBarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontFamily" Value="{StaticResource WidgetIconFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    The pin reads its state from the window rather than from a view model: Window.Topmost is
    already the one thing OnSettingsChanged keeps true, so binding to it means the button cannot
    disagree with the window it sits on, whichever surface made the change.

    Outline for off and solid for on - the state is never carried by the accent colour alone,
    which would be invisible under high contrast and to anyone who cannot separate the two.
  -->
  <Style x:Key="TitleBarPinButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarIconButtonStyle}">
    <Setter Property="Content" Value="&#xE718;" />
    <Setter Property="ToolTip" Value="Keep above other windows" />
    <Setter Property="AutomationProperties.Name" Value="Keep above other windows" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter Property="Content" Value="&#xE841;" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="ToolTip" Value="Kept above other windows" />
        <Setter Property="AutomationProperties.Name" Value="Kept above other windows" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type controls:QuotaBar}">
    <Setter Property="TrackBrush" Value="{DynamicResource QuotaBarTrackBrush}" />
    <Setter Property="AccentFillBrush" Value="{DynamicResource QuotaBarFillBrush}" />
    <Setter Property="HighFillBrush" Value="{DynamicResource QuotaBarHighFillBrush}" />
    <Setter Property="ExhaustedFillBrush" Value="{DynamicResource QuotaBarExhaustedFillBrush}" />
    <Setter Property="StaleFillBrush" Value="{DynamicResource QuotaBarStaleFillBrush}" />
    <Setter Property="HatchBrush" Value="{DynamicResource QuotaBarHatchBrush}" />
    <Setter Property="MarkerBrush" Value="{DynamicResource ElapsedMarkerBrush}" />
    <Setter Property="MarkerGapBrush" Value="{DynamicResource ElapsedMarkerGapBrush}" />
  </Style>

  <Style TargetType="{x:Type controls:StateGlyph}">
    <Setter Property="GlyphBrush" Value="{DynamicResource StateWarnBrush}" />
    <Style.Triggers>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Connected}"><Setter Property="GlyphBrush" Value="{DynamicResource StateOkBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Stale}"><Setter Property="GlyphBrush" Value="{DynamicResource TextTertiaryBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Unavailable}"><Setter Property="GlyphBrush" Value="{DynamicResource StateWarnBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Error}"><Setter Property="GlyphBrush" Value="{DynamicResource StateBadBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Unsupported}"><Setter Property="GlyphBrush" Value="{DynamicResource TextTertiaryBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.NotInstalled}"><Setter Property="GlyphBrush" Value="{DynamicResource TextTertiaryBrush}" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type controls:StateChip}">
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:StateChip}">
          <StackPanel Orientation="Horizontal">
            <controls:StateGlyph State="{TemplateBinding State}" VerticalAlignment="Center" />
            <TextBlock Margin="2,0,0,0" Text="{TemplateBinding Label}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type controls:TierBadge}">
    <Setter Property="ToolTip" Value="Unofficial: values are read from an undocumented source and may change or stop without notice." />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:TierBadge}">
          <Border x:Name="Background" Padding="4,2" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
            <Grid>
              <Rectangle x:Name="DashedOutline" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1" StrokeDashArray="2,1"
                         RadiusX="{Binding CornerRadius.TopLeft, ElementName=Background}"
                         RadiusY="{Binding CornerRadius.TopLeft, ElementName=Background}" />
              <StackPanel Orientation="Horizontal" Margin="2,0">
                <Grid Width="7" Height="6" VerticalAlignment="Center">
                  <!-- Filled, as the design draws it (a CSS border triangle, 7x6 solid ink-3).
                       Stroked it was a chevron riding above the capitals: a 1px pen straddles the
                       path, so the base fell on a half-pixel and faded to nothing, while the miter
                       join at the apex spiked a whole pixel above the 7x6 box it was allotted. -->
                  <Polygon x:Name="Triangle" Points="0,6 3.5,0 7,6" Fill="{DynamicResource TextTertiaryBrush}" />
                  <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="Label" Margin="4,0,0,0" Text="UNOFFICIAL" Style="{StaticResource CaptionMicroTextStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tier" Value="{x:Static domain:MechanismTier.Official}">
              <Setter TargetName="Background" Property="Background" Value="{DynamicResource WidgetLayerAltBackgroundBrush}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{DynamicResource WidgetCardStrokeBrush}" />
              <Setter TargetName="DashedOutline" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Triangle" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              <Setter TargetName="Label" Property="Text" Value="OFFICIAL" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Setter Property="ToolTip" Value="Official: values come from a documented, provider-supported interface." />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SettingsSectionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionMicroTextStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>

  <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="Height" Value="{DynamicResource SettingsRowHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{TemplateBinding Content}" Style="{StaticResource BodySmallTextStyle}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
            <Border Grid.Column="1" x:Name="Box" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="{DynamicResource RadiusChip}" Background="{DynamicResource WidgetLayerAltBackgroundBrush}" BorderBrush="{DynamicResource WidgetCardStrokeBrush}" BorderThickness="1">
              <TextBlock x:Name="Tick" Text="&#x2713;" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chip" Padding="8,4" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent" BorderBrush="{DynamicResource WidgetCardStrokeBrush}" BorderThickness="1">
            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WidgetLayerAltBackgroundBrush}" />
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="0,6" />
  </Style>
</ResourceDictionary>
