<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AiUsageMonitor.App.Controls"
                    xmlns:domain="clr-namespace:AiUsageMonitor.Domain;assembly=AiUsageMonitor.Domain">
  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

  <Style x:Key="LinkButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource WidgetFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
    </Style.Triggers>
  </Style>

  <!-- The title bar's icon buttons. Same 30x26 hit area as the minimise and close glyphs beside
       them, so the row reads as one set rather than as two kinds of control. -->
  <Style x:Key="TitleBarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontFamily" Value="{StaticResource WidgetIconFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    The pin reads its state from the window rather than from a view model: Window.Topmost is
    already the one thing OnSettingsChanged keeps true, so binding to it means the button cannot
    disagree with the window it sits on, whichever surface made the change.

    Outline for off and solid for on - the state is never carried by the accent colour alone,
    which would be invisible under high contrast and to anyone who cannot separate the two.

    The copy names both halves of what the pin now does. Staying above other windows and surviving
    a click on one of them are the same intent, so they are the same control - but a user who only
    read "keep above other windows" would have no way to know which button stops the widget
    disappearing when they click away.
  -->
  <Style x:Key="TitleBarPinButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarIconButtonStyle}">
    <Setter Property="Content" Value="&#xE718;" />
    <Setter Property="ToolTip" Value="Keep above other windows, and open when you click one" />
    <Setter Property="AutomationProperties.Name" Value="Keep above other windows, and open when you click one" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter Property="Content" Value="&#xE841;" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="ToolTip" Value="Kept above other windows, and open when you click one" />
        <Setter Property="AutomationProperties.Name" Value="Kept above other windows, and open when you click one" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type controls:QuotaBar}">
    <Setter Property="TrackBrush" Value="{DynamicResource QuotaBarTrackBrush}" />
    <Setter Property="AccentFillBrush" Value="{DynamicResource QuotaBarFillBrush}" />
    <Setter Property="HighFillBrush" Value="{DynamicResource QuotaBarHighFillBrush}" />
    <Setter Property="ExhaustedFillBrush" Value="{DynamicResource QuotaBarExhaustedFillBrush}" />
    <Setter Property="StaleFillBrush" Value="{DynamicResource QuotaBarStaleFillBrush}" />
    <Setter Property="HatchBrush" Value="{DynamicResource QuotaBarHatchBrush}" />
    <Setter Property="MarkerBrush" Value="{DynamicResource ElapsedMarkerBrush}" />
    <Setter Property="MarkerGapBrush" Value="{DynamicResource ElapsedMarkerGapBrush}" />
  </Style>

  <Style TargetType="{x:Type controls:StateGlyph}">
    <Setter Property="GlyphBrush" Value="{DynamicResource StateWarnBrush}" />
    <Style.Triggers>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Connected}"><Setter Property="GlyphBrush" Value="{DynamicResource StateOkBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Stale}"><Setter Property="GlyphBrush" Value="{DynamicResource TextTertiaryBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Unavailable}"><Setter Property="GlyphBrush" Value="{DynamicResource StateWarnBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Error}"><Setter Property="GlyphBrush" Value="{DynamicResource StateBadBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.Unsupported}"><Setter Property="GlyphBrush" Value="{DynamicResource TextTertiaryBrush}" /></Trigger>
      <Trigger Property="State" Value="{x:Static domain:ConnectionState.NotInstalled}"><Setter Property="GlyphBrush" Value="{DynamicResource TextTertiaryBrush}" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type controls:StateChip}">
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:StateChip}">
          <StackPanel Orientation="Horizontal">
            <controls:StateGlyph State="{TemplateBinding State}" VerticalAlignment="Center" />
            <TextBlock Margin="2,0,0,0" Text="{TemplateBinding Label}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type controls:TierBadge}">
    <Setter Property="ToolTip" Value="Unofficial: values are read from an undocumented source and may change or stop without notice." />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:TierBadge}">
          <!-- The dashed edge is a Rectangle because a Border cannot dash its own, but it has to be
               drawn where that edge would be. Nested inside the Border it landed five pixels further
               in than the OFFICIAL badge's solid border, so the triangle was pinned against the
               dashes while the dot sat comfortably clear of its frame - the two badges were not the
               same badge. Sibling of the Border, same cell, same bounds: both marks now start 7px in
               (1 border, 4 padding, 2 margin). The 0.5 margin puts the Rectangle's centred stroke on
               the same pixel the Border paints its own. -->
          <Grid>
            <Rectangle x:Name="DashedOutline" Margin="0.5" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1" StrokeDashArray="2,1"
                       RadiusX="{Binding CornerRadius.TopLeft, ElementName=Background}"
                       RadiusY="{Binding CornerRadius.TopLeft, ElementName=Background}" />
            <Border x:Name="Background" Padding="4,2" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Margin="2,0">
                <Grid Width="7" Height="6" VerticalAlignment="Center">
                  <!-- Filled, as the design draws it (a CSS border triangle, 7x6 solid ink-3).
                       Stroked it was a chevron riding above the capitals: a 1px pen straddles the
                       path, so the base fell on a half-pixel and faded to nothing, while the miter
                       join at the apex spiked a whole pixel above the 7x6 box it was allotted. -->
                  <Polygon x:Name="Triangle" Points="0,6 3.5,0 7,6" Fill="{DynamicResource TextTertiaryBrush}">
                    <!-- Lifted a pixel, because centring the box does not centre the shape: a solid
                         up-pointing triangle carries its weight at the base, so its centroid lies a
                         third of its height - 1px of 6 - below the middle of its box. Measured
                         against the ink of the capitals beside it, box-centred put the triangle
                         1.2px low; lifted it sits 0.2px low, which is where the OFFICIAL dot lands
                         on its own. A disc needs no such correction, so the lift belongs on the
                         triangle and not on the Grid the two shapes share. -->
                    <Polygon.RenderTransform>
                      <TranslateTransform Y="-1" />
                    </Polygon.RenderTransform>
                  </Polygon>
                  <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="Label" Margin="4,0,0,0" Text="UNOFFICIAL" Style="{StaticResource CaptionMicroTextStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
              </StackPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tier" Value="{x:Static domain:MechanismTier.Official}">
              <Setter TargetName="Background" Property="Background" Value="{DynamicResource WidgetLayerAltBackgroundBrush}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{DynamicResource WidgetCardStrokeBrush}" />
              <Setter TargetName="DashedOutline" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Triangle" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              <Setter TargetName="Label" Property="Text" Value="OFFICIAL" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
              <Setter Property="ToolTip" Value="Official: values come from a documented, provider-supported interface." />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SettingsSectionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionMicroTextStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>

  <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="Height" Value="{DynamicResource SettingsRowHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{TemplateBinding Content}" Style="{StaticResource BodySmallTextStyle}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
            <Border Grid.Column="1" x:Name="Box" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="{DynamicResource RadiusChip}" Background="{DynamicResource WidgetLayerAltBackgroundBrush}" BorderBrush="{DynamicResource WidgetCardStrokeBrush}" BorderThickness="1">
              <TextBlock x:Name="Tick" Text="&#x2713;" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chip" Padding="8,4" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent" BorderBrush="{DynamicResource WidgetCardStrokeBrush}" BorderThickness="1">
            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WidgetLayerAltBackgroundBrush}" />
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="0,6" />
  </Style>
  <Style x:Key="SettingsNavGroupTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionMicroTextStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="Margin" Value="12,14,12,4" />
  </Style>

  <!--
    The sidebar entry. Templated rather than themed through the default ListBoxItem because that one
    paints the system highlight colour, which belongs to no palette here and is invisible under high
    contrast against the layer it sits on. Selection is carried by the fill AND the weight, never by
    colour alone.
  -->
  <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Fill" Margin="6,1" Padding="8,5" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent">
            <TextBlock x:Name="Label" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodySmallTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource WidgetLayerAltBackgroundBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter TargetName="Fill" Property="BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The widget's scrollbar.

       Two things are wrong with the stock one here, and both are visible the moment the list
       outgrows the 520px ceiling (tokens.md §3) - which an error notice on a provider card is
       enough to do. It paints Windows' own light chrome inside a themed dark surface, and it
       occupies a layout column, so every card silently narrows by its width at the exact moment
       something has gone wrong and the cards have most to say.

       This template fixes the second problem by putting the bar in the SAME grid cell as the
       content rather than a column beside it. The thumb is 4px inside an 8px hit area, which sits
       within the list's existing 10px WidgetBodyPadding, so it overlays padding rather than text.

       Keyed, not implicit: the settings window is a resizable ordinary window where the standard
       scrollbar is right, and an unkeyed style would reach it too. -->
  <Style x:Key="OverlayScrollBarThumbStyle" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <!-- Transparent outer border, painted inner one: the hit area stays a comfortable 8px
               while the mark on screen is 4px. -->
          <Border Background="Transparent" Padding="2,0">
            <Border x:Name="Mark" Width="4" CornerRadius="2" Opacity="0.4"
                    Background="{DynamicResource TextTertiaryBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Mark" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Mark" Property="Opacity" Value="0.95" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OverlayScrollBarStyle" TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <!-- No track brush and no line buttons. A track would draw a channel the design does not
               have, and the arrows are 17px of chrome each for a list that is never more than a
               few cards long. IsDirectionReversed is required on a vertical track: without it the
               thumb travels the wrong way. MinHeight keeps the thumb grabbable on long content. -->
          <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
            <Track.Thumb>
              <Thumb Style="{StaticResource OverlayScrollBarThumbStyle}" MinHeight="24" />
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
            </Track.IncreaseRepeatButton>
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
            </Track.DecreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WidgetScrollViewerStyle" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <!-- One cell, two children: the bar floats over the content instead of displacing it. -->
          <Grid>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Margin="{TemplateBinding Padding}" />
            <ScrollBar x:Name="PART_VerticalScrollBar"
                       Style="{StaticResource OverlayScrollBarStyle}"
                       Orientation="Vertical"
                       HorizontalAlignment="Right"
                       Value="{TemplateBinding VerticalOffset}"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
