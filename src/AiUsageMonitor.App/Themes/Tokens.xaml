<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:Double x:Key="SpaceXXSmall">2</sys:Double>
  <sys:Double x:Key="SpaceXSmall">4</sys:Double>
  <sys:Double x:Key="SpaceSmall">6</sys:Double>
  <sys:Double x:Key="SpaceMedium">8</sys:Double>
  <sys:Double x:Key="SpaceLarge">10</sys:Double>
  <sys:Double x:Key="SpaceXLarge">12</sys:Double>
  <sys:Double x:Key="SpaceXXLarge">16</sys:Double>
  <sys:Double x:Key="WidgetWidth">360</sys:Double>
  <sys:Double x:Key="WidgetMaxHeight">520</sys:Double>
  <sys:Double x:Key="WidgetTitleBarHeight">32</sys:Double>
  <sys:Double x:Key="WidgetTitleBarHeightCompact">28</sys:Double>
  <sys:Double x:Key="WidgetFooterHeight">26</sys:Double>
  <sys:Double x:Key="WidgetFooterHeightCompact">24</sys:Double>
  <sys:Double x:Key="QuotaUsedColumnWidth">42</sys:Double>
  <sys:Double x:Key="QuotaResetColumnWidth">62</sys:Double>
  <sys:Double x:Key="QuotaColumnGutter">8</sys:Double>
  <sys:Double x:Key="QuotaBarHeight">5</sys:Double>
  <sys:Double x:Key="QuotaBarMargin">5</sys:Double>
  <sys:Double x:Key="ElapsedMarkerWidth">4</sys:Double>
  <sys:Double x:Key="ElapsedMarkerCoreWidth">2</sys:Double>
  <sys:Double x:Key="ElapsedMarkerHeight">11</sys:Double>
  <sys:Double x:Key="SettingsRowHeight">38</sys:Double>
  <sys:Double x:Key="TrayMenuItemHeight">30</sys:Double>
  <Thickness x:Key="ProviderCardPadding">11,8,11,9</Thickness>
  <Thickness x:Key="ProviderCardPaddingCompact">9,6,9,7</Thickness>
  <Thickness x:Key="QuotaRowPadding">0,6,0,5</Thickness>
  <Thickness x:Key="QuotaRowPaddingCompact">0,4,0,4</Thickness>
  <CornerRadius x:Key="RadiusWindow">8</CornerRadius>
  <CornerRadius x:Key="RadiusCard">6</CornerRadius>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusChip">3</CornerRadius>
  <CornerRadius x:Key="RadiusBar">1</CornerRadius>
  <FontFamily x:Key="WidgetFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="WidgetDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="WidgetMonoFontFamily">Cascadia Mono, Consolas</FontFamily>
  <!-- Fluent ships with Windows 11 and MDL2 with 10; the codepoints used here exist in both, so
       the fallback keeps the title bar drawn on a machine that has only the older font. -->
  <FontFamily x:Key="WidgetIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <Style x:Key="BaseTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource WidgetFontFamily}" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="CaptionMicroTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}"><Setter Property="FontSize" Value="11" /></Style>
  <Style x:Key="BodySmallTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}"><Setter Property="FontSize" Value="11.5" /></Style>
  <Style x:Key="BodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}"><Setter Property="FontSize" Value="12.5" /></Style>
  <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="NumericTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}"><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="SubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="TokenTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}"><Setter Property="FontFamily" Value="{StaticResource WidgetMonoFontFamily}" /><Setter Property="FontSize" Value="11.5" /></Style>
</ResourceDictionary>
