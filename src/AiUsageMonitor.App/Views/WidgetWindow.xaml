<Window x:Class="AiUsageMonitor.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AiUsageMonitor.App.Views"
        Title="AI Usage Monitor — by nayots"
        Width="360" MaxHeight="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WidgetWindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource WidgetFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ContextMenu x:Key="TrayMenu">
      <MenuItem Header="Open" Click="TrayOpen_Click" />
      <MenuItem Header="Refresh all providers" Click="TrayRefresh_Click" />
      <MenuItem Header="Settings" Click="TraySettings_Click" />
      <!-- The only checkable item, which is how the code-behind finds it: x:Name inside a resource
           dictionary generates no field to reach it by. -->
      <MenuItem Header="Mini mode" IsCheckable="True" Click="TrayMini_Click" />
      <MenuItem Header="Diagnostics" Click="TrayDiagnostics_Click" />
      <Separator />
      <MenuItem Header="Exit" Click="TrayExit_Click" />
    </ContextMenu>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource WidgetWindowStrokeBrush}" BorderThickness="1"
          CornerRadius="{DynamicResource RadiusWindow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Height" Value="{DynamicResource WidgetTitleBarHeight}" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Height" Value="{DynamicResource WidgetTitleBarHeightCompact}" /></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Two Runs rather than one string: the product names itself, the attribution says who
             made it, and they are not equals. The maker's line drops to tertiary and to regular
             weight so it reads as a byline rather than as part of the name. Written back to back
             on one line on purpose - whitespace between two inlines collapses to a space, which
             on top of the leading space in the second Run would render as two. The brand is
             lowercase in every context (nayots BRAND.md 4), including mid-sentence here. -->
        <TextBlock Grid.Column="0" Margin="11,0,0,0" VerticalAlignment="Center"
                   FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="AI Usage Monitor" /><Run Text=" — by nayots" FontWeight="Normal" Foreground="{DynamicResource TextTertiaryBrush}" /></TextBlock>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,4,0">
          <Button Style="{StaticResource TitleBarPinButtonStyle}" Click="Pin_Click" />
          <Button Style="{StaticResource TitleBarIconButtonStyle}" Content="&#xE713;" Click="Settings_Click"
                  ToolTip="Settings" AutomationProperties.Name="Settings" />
          <!-- No minimise button. With no taskbar button to minimise towards, it could only do what
               the one beside it already does, under a glyph that promises something else. -->
          <Button Width="30" Height="26" Content="&#x2715;" FontSize="11" Click="Close_Click"
                  Style="{StaticResource LinkButtonStyle}"
                  Foreground="{DynamicResource TextSecondaryBrush}"
                  ToolTip="Hide to the notification area"
                  AutomationProperties.Name="Hide to the notification area" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" Style="{StaticResource WidgetScrollViewerStyle}">
        <!-- Cards carry the gap below them, so the list's own bottom margin is 2 rather than the
             full body padding - together they make the body padding the design specifies for each
             density. 2 + 8 = 10 standard, 2 + 6 = 8 compact.

             Margin is a Style setter rather than an attribute here, and in the title bar and footer
             above: WPF ranks a local value above a style trigger, so an attribute would beat the
             compact trigger silently - no warning, no exception, just chrome that never gets
             tighter. The container's trigger binds IsCompact directly because a container's
             DataContext is the card it presents, not this window's view model. -->
        <ItemsControl x:Name="ProviderList" ItemsSource="{Binding Providers}" Focusable="False">
          <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Margin" Value="{DynamicResource WidgetBodyPadding}" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="{DynamicResource WidgetBodyPaddingCompact}" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
          <!-- A provider the user hid, or one filtered out as unavailable, leaves through its
               container rather than through a filtered collection: Providers is the single list the
               footer count, the tray glyph and the alert watcher all read, and each of them applies
               IsHiddenByFilter itself. Collapsed rather than Hidden, so the card costs no height -
               Hidden would leave a card-sized gap and the margin below it. -->
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Margin" Value="{DynamicResource ProviderCardGap}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="{DynamicResource ProviderCardGapCompact}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsHiddenByFilter}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <views:ProviderCardView />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- The body when the filter admits nothing. It shares row 1 with the list rather than
           replacing it, because the list is not wrong in that state - it is correctly empty, and
           the collapsed cards inside it cost no height. Centred and given real vertical padding so
           the widget keeps a body: a window that shrinks to title bar plus footer reads as broken
           rather than as empty. -->
      <Border x:Name="EmptyState" Grid.Row="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Padding" Value="14,28" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasVisibleProviders}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsCompact}" Value="True">
                <Setter Property="Padding" Value="14,20" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="EmptyStateMessage" Text="{Binding EmptyStateText}"
                     Style="{StaticResource BodyTextStyle}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <!-- Tertiary and one step down in size: the remedy is secondary to the fact, and a hint
               set as loudly as the statement above it reads as a second, competing statement. -->
          <TextBlock x:Name="EmptyStateRemedy" Text="{Binding EmptyStateHint}" Margin="0,5,0,0"
                     Style="{StaticResource CaptionTextStyle}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     TextAlignment="Center" TextWrapping="Wrap"
                     Visibility="{Binding HasEmptyStateHint, Converter={StaticResource BooleanToVisibility}}" />
        </StackPanel>
      </Border>

      <Border x:Name="Footer" Grid.Row="2" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource WidgetWindowStrokeBrush}">
        <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="{DynamicResource WidgetFooterHeight}" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Height" Value="{DynamicResource WidgetFooterHeightCompact}" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid Margin="11,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!-- The provider count and the build, as two bindings rather than one pre-joined string:
               they answer different questions and only one of them can be absent. The separator
               shares the version's visibility so a build that could not be read leaves no orphaned
               interpunct behind it. -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding FooterText}"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock Text="&#160;&#183;&#160;"
                       Visibility="{Binding HasVersionText, Converter={StaticResource BooleanToVisibility}}"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock Text="{Binding VersionText}"
                       Foreground="{DynamicResource TextTertiaryBrush}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasVersionText}" Value="True" />
                        <Condition Binding="{Binding HasUpdate}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <!-- Secondary, not accent: Refresh stays the one accent action in this bar. Shown in
                 place of the plain version, never beside it - two versions in one footer would read
                 as two facts about the providers above rather than one about the application. -->
            <Button Content="{Binding UpdateFooterText}"
                    Style="{StaticResource LinkButtonStyle}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Click="Update_Click"
                    ToolTip="A newer version is available — open its release page"
                    AutomationProperties.Name="A newer version is available. Open its release page."
                    Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibility}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Secondary, not accent. Refresh acts on what is already on screen and stays the one
                 accent action in the bar; this one navigates away from the application entirely,
                 and two accent links side by side would read as a pair of equals. The tooltip names
                 the destination, because a click that opens a browser should say where it goes
                 before it is clicked. -->
            <Button x:Name="FooterProjectButton" Content="GitHub" Margin="0,0,14,0"
                    Style="{StaticResource LinkButtonStyle}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Click="Project_Click"
                    ToolTip="Open https://github.com/nayots/ai-agent-usage-monitor"
                    AutomationProperties.Name="Open the project on GitHub" />
            <Button x:Name="FooterRefreshButton" Content="Refresh"
                    Style="{StaticResource LinkButtonStyle}" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
